{
  "name": "cloudnest-os",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "CloudNest native storage and independent Brain",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:brain": "node --test brain/tests/*.test.mjs",
    "dev:brain": "npm run build:console && wrangler dev --config brain/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "test:mac": "bash scripts/swift.sh test",
    "build:mac": "bash scripts/build-mac.sh",
    "audit:source": "node scripts/audit-public-source.mjs",
    "check": "npm run typecheck && npm run typecheck:web && npm run test:brain && npm run test:web && npm run test:setup && npm run test:mac",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "build:console": "node scripts/build-console.mjs",
    "test:web": "node --test web/tests/*.test.mjs",
    "test:setup": "node --test scripts/setup-brain.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.25.12",
    "miniflare": "5.20261023.3-beta",
    "typescript": "5.9.3",
    "wrangler": "4.156.0",
    "@types/three": "0.186.0"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
