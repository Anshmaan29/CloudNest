{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cloudnest-brain", "main": "worker/index.ts",
  "compatibility_date": "2026-10-30", "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB", "database_name": "cloudnest-brain",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": { "ALLOWED_ORIGINS": "", "PUBLIC_ORIGIN": "" }
}
